{
  "name": "kairon-browser",
  "version": "1.0.0",
  "description": "Privacy-focused browser with AI sidebar",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.kairon.browser",
    "productName": "Kairon Browser",
    "asar": true,
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Kaironbrowser",
      "repo": "Browser"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/tests",
      "!**/.git"
    ]
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-icon-builder": "^2.0.1",
    "sharp": "^0.35.2"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.5.1",
    "better-sqlite3": "^13.0.3",
    "cross-fetch": "^3.1.5",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "ws": "^8.21.3"
  }
}
